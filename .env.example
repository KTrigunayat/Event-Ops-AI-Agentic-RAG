OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama
ENDEE_DB_PATH=./endeedb
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Endee Vector Database Configuration
# URL of the Endee server (default: http://localhost:8080)
ENDEE_SERVER_URL=http://localhost:8080
# Optional authentication token (leave empty if Endee runs without authentication)
ENDEE_AUTH_TOKEN=
# Name of the vector index to use
ENDEE_INDEX_NAME=event_ops_vectors
# Dimension of the embeddings (must match embedding model - DistilBERT default: 384)
ENDEE_DIMENSION=384
# Distance metric for similarity search (options: cosine, euclidean, dot)
ENDEE_METRIC=cosine

# Embedding Configuration
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=text-embedding-3-small
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=text-embedding-004

# LLM Configuration
GEMINI_FLASH_API_KEY=your_gemini_flash_api_key_here
GEMINI_FLASH_MODEL=gemini-1.5-flash
